# Copy to .env and fill in. Never commit .env.

# LLM
GEMINI_API_KEY=

# Who Socio acts for (used to sign emails)
AGENT_OWNER_NAME=

# Documents Socio may send (Google Drive folder name; read-only access)
AGENT_DRIVE_FOLDER=Socio Documents
# Optional local documents folder (default: ./documents)
# AGENT_FILES_DIR=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
AGENT_POLL_MINUTES=10

# Optional: which emails to process
# AGENT_INBOX_QUERY=in:inbox -from:me newer_than:7d
