# Copy to .env and fill in. Never commit .env.

# LLM
GEMINI_API_KEY=

# Who Socio acts for (used to sign emails)
AGENT_OWNER_NAME=

# Optional: limit Socio to one Google Drive folder (default: your whole Drive)
# AGENT_DRIVE_FOLDER=
# Optional local documents folder (default: ./documents)
# AGENT_FILES_DIR=

# Add a Google Task when something needs you (1 = on, 0 = off)
AGENT_AUTO_TASKS=1

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
AGENT_POLL_MINUTES=10

# Optional: which emails to process
# AGENT_INBOX_QUERY=in:inbox -from:me newer_than:7d

# Optional: memory, skills, and parallel tasks
# AGENT_MEMORY=1            # learn from approvals/rejections and recall them (0 = off)
# AGENT_MAX_WORKERS=3       # tasks of one instruction that run in parallel
# AGENT_LLM_RPM=14          # Gemini requests per minute, shared (free tier allows 15)
# AGENT_SKILLS_DIR=         # default ./skills
# AGENT_MODEL_CACHE=        # embedding model download folder, default ./.cache/fastembed
