# Copy to .env and fill in. Never commit .env.

# LLM (check the keys: python scripts/verify_keys.py)
# Owner/email work and planning: Gemini primary -> Gemini fallback -> Gemini fallback 2 -> Mistral.
# Parallel subtasks (workers): Mistral -> Groq -> Gemini fallback 2 -> Gemini fallback -> Gemini primary.
# Use keys from different Google Cloud projects: quota is per project.
GEMINI_API_KEY=
GEMINI_FALLBACK_API_KEY=
# Optional third key; give it another model, since "model overloaded" (HTTP 503) hits every key at once.
GEMINI_FALLBACK_2_API_KEY=
# AGENT_GEMINI_FALLBACK_2_MODEL=gemini-3.5-flash
MISTRAL_API_KEY=
GROQ_API_KEY=
# AGENT_GEMINI_MODEL=gemini-3.5-flash-lite
# AGENT_MISTRAL_MODEL=ministral-14b-latest   # mistral-small/medium get 0 requests/min on the free tier
# AGENT_GROQ_MODEL=openai/gpt-oss-120b

# Who Socio acts for (used to sign emails)
AGENT_OWNER_NAME=

# Optional: limit Socio to one Google Drive folder (default: your whole Drive)
# AGENT_DRIVE_FOLDER=
# Optional local documents folder (default: ./documents)
# AGENT_FILES_DIR=

# Add a Google Task automatically when an email needs you (default 0 = off:
# Socio only creates tasks you ask for, after you approve them)
AGENT_AUTO_TASKS=0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
AGENT_POLL_MINUTES=10

# Optional: which emails to process
# AGENT_INBOX_QUERY=in:inbox -from:me newer_than:7d

# Optional: memory, skills, and parallel tasks
# AGENT_MEMORY=1            # remember rules you add (/remember, or ask in chat) and recall them (0 = off)
# AGENT_MAX_WORKERS=3       # tasks of one instruction that run in parallel
# AGENT_WORKER_TIMEOUT=180  # seconds one such task may take before it is stopped
# AGENT_LLM_RPM=14          # Gemini requests per minute per key, shared (free tier allows 15)
# AGENT_MISTRAL_RPM=28      # Mistral requests per minute, shared (ministral-14b free tier allows 30)
# AGENT_GROQ_RPM=28         # Groq requests per minute, shared (free tier allows 30)
# AGENT_SKILLS_DIR=         # default ./skills
# AGENT_MODEL_CACHE=        # embedding model download folder, default ./.cache/fastembed
# AGENT_LOG_DIR=            # where agent.log (full error details) goes, default ./logs

# Optional: data retention (the bot deletes old records once a day, then checkpoints the WAL; 0 = keep forever)
# RETENTION_DAYS_OPERATIONAL=30  # finished runs, decided cards, action/failure logs, uncorrected failure cases
# RETENTION_DAYS_MESSAGES=90     # Telegram conversation turns
# RETENTION_DAYS_ANCHORS=1       # what the chat is about (thread / contact / document)

# Optional: routines ("send me the AI news every day at 9")
# AGENT_SCHEDULE_GRACE_HOURS=6   # a routine missed while the bot was off still runs if at most this late
# AGENT_NEWS_FEEDS=              # replace the default news sites: comma-separated feed URLs, optionally "Name|URL"

# Optional: Langfuse tracing (check: python scripts/verify_langfuse.py). OFF unless
# LANGFUSE_TRACING_ENABLED=true AND both keys are set. Traces send prompts, email text and your
# Telegram messages to Langfuse (base64 stripped): leave it off to keep personal data local.
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or https://us.cloud.langfuse.com / self-hosted
# LANGFUSE_TRACING_ENVIRONMENT=production         # default production; the checks use development
